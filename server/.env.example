PORT=8030
DB_PATH=./floorfeed.db
# AI takes: Claude if a key is set, otherwise local Ollama
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=nimble:latest
# Optional: Helius webhook auth header (Phase 2, wallet-level tracking)
HELIUS_WEBHOOK_SECRET=
# Helius RPC + API (wallet balances, tx simulation, webhooks)
HELIUS_API_KEY=
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
# Privy server credentials (verify user access tokens)
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# 0 = API only, no Magic Eden polling (local dev next to production)
INGEST=
# X posting (optional): drafts go to Telegram for Post/Skip, then the
# browser poster in tools/x-poster publishes approved ones.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Shared secret between the API and tools/x-poster (any long random string)
SOCIAL_TOKEN=
# Kinds to post without approval, e.g. movers,bigsale (default: none)
SOCIAL_AUTO_APPROVE=
